{
  "name": "benefit",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && tsc-alias",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "test:db:start": "docker compose --env-file .env.test -f docker-compose.test.yaml up -d",
    "test:db:stop": "docker compose -f docker-compose.test.yaml down -v",
    "test": "npm run test:db:start && sleep 5 && jest --runInBand --verbose && npm run test:db:stop"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.721.0",
    "@nestjs-modules/ioredis": "^2.0.2",
    "@nestjs/axios": "^3.0.3",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.1.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/typeorm": "^10.0.2",
    "@types/cache-manager": "^4.0.6",
    "@types/cron": "^2.4.0",
    "@types/crypto-js": "^4.2.2",
    "@types/multer": "^1.4.12",
    "@types/passport-jwt": "^4.0.1",
    "cache-manager": "^6.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "crypto-js": "^4.2.0",
    "ioredis": "^5.4.1",
    "moment": "^2.30.1",
    "mongoose": "^8.12.1",
    "mysql2": "^3.11.1",
    "nest-winston": "^1.9.7",
    "passport-custom": "^1.1.1",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "tsc-alias": "^1.8.15",
    "typeorm": "^0.3.20",
    "typeorm-transactional": "^0.5.0",
    "winston": "^3.14.2",
    "winston-daily-rotate-file": "^5.0.0",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.4.7",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@src/(.*)$": "<rootDir>/src/$1",
      "^@common/(.*)$": "<rootDir>/src/common/$1",
      "^@config/(.*)$": "<rootDir>/src/config/$1",
      "^@entity/(.*)$": "<rootDir>/src/entity/$1",
      "^@schema/(.*)$": "<rootDir>/src/schema/$1",
      "^@activity/(.*)$": "<rootDir>/src/module/activity/$1",
      "^@admin/(.*)$": "<rootDir>/src/module/admin/$1",
      "^@auth/(.*)$": "<rootDir>/src/module/auth/$1",
      "^@aws/(.*)$": "<rootDir>/src/module/aws/$1",
      "^@file/(.*)$": "<rootDir>/src/module/file/$1",
      "^@global/(.*)$": "<rootDir>/src/module/global/$1",
      "^@health/(.*)$": "<rootDir>/src/module/health/$1",
      "^@intranet/(.*)$": "<rootDir>/src/module/intranet/$1",
      "^@meal/(.*)$": "<rootDir>/src/module/meal/$1",
      "^@notice/(.*)$": "<rootDir>/src/module/notice/$1",
      "^@playground/(.*)$": "<rootDir>/src/module/playground/$1",
      "^@redis/(.*)$": "<rootDir>/src/module/redis/$1",
      "^@scheduler/(.*)$": "<rootDir>/src/module/scheduler/$1",
      "^@user/(.*)$": "<rootDir>/src/module/user/$1",
      "^@welfare/(.*)$": "<rootDir>/src/module/welfare/$1"
    },
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.ts"
    ]
  }
}
